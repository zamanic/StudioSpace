# MongoDB (Atlas) - shared with the Express server
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mr9tml6.mongodb.net/
BETTER_AUTH_DB_URL=mongodb+srv://<user>:<password>@cluster0.mr9tml6.mongodb.net/

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Social OAuth (optional - a provider is only registered when both halves are set)
# Google: register http://localhost:3000/api/auth/callback/google as an
# authorized redirect URI, otherwise Google returns redirect_uri_mismatch.
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# GitHub: the app's callback URL must be
# http://localhost:3000/api/auth/callback/github
BETTER_AUTH_GITHUB_CLIENT_ID=
BETTER_AUTH_GITHUB_SECRET=
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false

# Express API
NEXT_PUBLIC_API_URL=http://localhost:8000
